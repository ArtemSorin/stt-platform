@startuml stt-platform-c4
!pragma layout smetana
!include <C4/C4_Container>

title stt-platform — C4 Container
LAYOUT_LEFT_RIGHT()
HIDE_PERSON_SPRITE()
HIDE_STEREOTYPE()

Person(candidate, "Кандидат", "Проходит интервью")
Person(interviewer, "Интервьюер", "Проводит интервью и получает результаты")
Container_Ext(browser, "Браузер", "HTML / JavaScript", "Захват эталона и PCM16; /test.html — тестовый режим без диаризации")

System_Boundary(platform, "stt-platform · локальная машина") {
    Container(stt, "STT + диаризация", "Docker Compose · Linux amd64/arm64 · Java 17 · :8080", "Нативный CPU runtime NeMo и sherpa-onnx; Vosk и CAM++; браузерное API. В основном режиме обязательны эталон и диаризация.")
    Container(analytics, "Аналитика", "Spring Boot 3.3.5 · Java 17 · :8083", "Банк, live-решения, снимок интервью, очередь заданий, восстановление состояния и экспорт XLSX.")
    Container(worker, "Фоновая финализация", "Docker Compose · Java 17 · private :8090", "Арендует задание, сверяет входы, распознаёт каналы, восстанавливает ответы и повторно публикует результат.")
    Container(whisper, "Whisper helper", "Python · :9000", "Итоговое распознавание каналов faster-whisper small по заданию обработчика.")
    Container(frida, "FRIDA helper · optional", "Python · :9100", "Семантическая оценка; локальная модель не проверялась.")
    ContainerDb(models, "Артефакты моделей", "Файлы вне Git", "Vosk, Nemotron, CAM++, Whisper и FRIDA (если установлена).")
    ContainerDb(reports, "Очередь архивирования аналитики", "Постоянный том Compose", "Повторная доставка legacy-отчётов и реестровых операций.")
    ContainerDb(transcripts, "Рабочие данные STT", "Постоянный том Compose", "PCM-запись, очередь входных файлов и временные результаты.")
    ContainerDb(database, "Реестр интервью и банк", "PostgreSQL · Compose", "Версии банка, снимки интервью, задания и метаданные файлов.")
    ContainerDb(objects, "Приватный архив", "S3 API · SeaweedFS в Compose", "Двухканальный WAV, журналы, входы повтора, staging и подтверждённые результаты.")
}

Rel_R(candidate, browser, "интервью")
Rel_R(interviewer, browser, "управляет интервью")
Rel_R(browser, stt, "HTTP API · PCM16 16 кГц, два канала")
Rel_R(stt, analytics, "внутренний /ws/interview-events · JSON в обе стороны")
Rel_D(worker, whisper, "HTTP · итоговое распознавание обоих каналов")
Rel_D(worker, analytics, "HTTP · аренда, ответы и XLSX")
Rel_D(worker, objects, "читает входы, сохраняет staging и результаты")
Rel_D(stt, transcripts, "временная запись, затем MD и ZIP")
Rel_D(analytics, frida, "HTTP · JSON оценки")
Rel_D(analytics, reports, "legacy-очередь архивирования")
Rel_D(analytics, database, "банк и реестр")
Rel_D(analytics, objects, "legacy-очередь и XLSX")
Rel_D(stt, objects, "очередь: WAV и журналы")
Rel_D(stt, analytics, "внутренний HTTP: регистрация и получение результатов")
Rel_D(whisper, models, "faster-whisper")
Rel_D(frida, models, "FRIDA, если установлена")

note bottom of models
  Версии и подтверждённые снимки:
  Vosk vosk-model-small-ru-0.22 (Compose); vosk-model-ru-0.42 (Windows)
  Nemotron-3-Diarization Q8_0 · ревизия f667ed73…
  CAM++ speech_campplus_sv_zh_en_16k-common_advanced · SHA-256 aa3cfc16…
  Whisper small · Systran/faster-whisper-small@536b0662…
  FRIDA ai-forever/FRIDA-Decisions@main · загрузка не закреплена; тестировался fake backend
  Полные хеши и оговорки: docs/models.md
end note

note bottom of platform
  common — Java/Maven-библиотека 1.0.0, включается в сервисы при сборке и отдельно не запускается.
  /test.html считает микрофон речью кандидата и пропускает эталон и диаризацию.
  Образы собираются под архитектуру Docker Engine; эмуляция amd64 на ARM не нужна.
  S3-порт SeaweedFS доступен внутри Docker-сети и не публикуется на хосте.
end note

@enduml
